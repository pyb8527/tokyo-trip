# Cloudflare 터널 토큰
#   Zero Trust 대시보드 → Networks → Tunnels → 터널 생성 시 발급되는 값
#   "eyJhIjoi..." 로 시작하는 긴 문자열입니다.
#
# 사용법:
#   cp .env.example .env
#   vi .env                      # 토큰 붙여넣기
#   docker compose --profile tunnel up -d
#
# ⚠️ .env 는 .gitignore 에 걸려 있습니다. 절대 커밋하지 마세요.
#    이 토큰이 있으면 남이 내 터널에 붙을 수 있습니다.

TUNNEL_TOKEN=여기에_터널_토큰
